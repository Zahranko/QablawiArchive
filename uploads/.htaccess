# Two separate jobs in this file. Both matter.

# 1. Nothing in this folder may ever be executed as code, so a file that
#    slips past validation is inert: it can only be read, never run.

php_flag engine off

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

RemoveHandler .php .phps .phtml .pht .php3 .php4 .php5 .php7 .php8
RemoveType .php .phps .phtml .pht

Options -ExecCGI -Indexes

# 2. Nothing in this folder may be fetched directly over HTTP either.
#    Uploads are private, and the web server would otherwise hand out
#    uploads/invoice.pdf to anyone who guessed the name, straight past the
#    login on index.php. file.php checks the session and then streams the
#    file, and it reads from disk, so this denial does not affect it.

Require all denied

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
