# Uploaded files belong to the live server, never to the repository.
# The folder itself is tracked only through its .htaccess, which must ship.
uploads/*
!uploads/.htaccess

# State file the FTP deploy action writes on the server.
.ftp-deploy-sync-state.json

# Local credential overrides. This is how you keep real passwords out of a
# public repository — see README.md.
config.local.php

# Local noise
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
